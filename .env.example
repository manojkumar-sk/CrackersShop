# Browser-safe. Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Browser-safe. Supabase publishable key (the anon key). This is the only Supabase key that may be public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Platform origin for invites and password-reset links. Include https, no path.
# For the first Vercel deploy, use the Vercel production URL.
# Example: https://yourapp.com
SITE_URL=https://yourapp.com

# Apex hostname only. No scheme, www, wildcard, port, or path.
# Leave unset until the production domain exists. *.vercel.app is never a tenant host.
PLATFORM_BASE_DOMAIN=yourapp.com
